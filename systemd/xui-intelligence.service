[Unit]
Description=X-UI Intelligence (read-only monitoring)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=xui-intelligence
Group=xui-intelligence
WorkingDirectory=/opt/xui-intelligence
EnvironmentFile=-/etc/xui-intelligence/xui-intelligence.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/xui-intelligence/venv/bin/xui-intelligence --config /etc/xui-intelligence/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/xui-intelligence

[Install]
WantedBy=multi-user.target
